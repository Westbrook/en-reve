{
  "name": "en-reve-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "scripts": {
    "test:probes": "node tooling/testing/invoke.mjs public --view='root#test:probes' --",
    "test:breadcrumbs-ssr": "node tooling/testing/invoke.mjs public --view='root#test:breadcrumbs-ssr' --",
    "test:breadcrumbs-ssr:browser": "node tooling/testing/invoke.mjs public --view='root#test:breadcrumbs-ssr:browser' --",
    "build": "npm run build -w @en-reve/tokens && npm run build -w @en-reve/styles && npm run build -w @en-reve/primitives && npm run build -w @en-reve/elements && npm run metadata && npm run build -w @en-reve/ssr && npm run build -w @en-reve/docs",
    "dev:docs": "npm run dev -w @en-reve/docs",
    "test:tokens": "node tooling/testing/invoke.mjs public --view='root#test:tokens' --",
    "test:properties:browser": "node tooling/testing/invoke.mjs public --view='root#test:properties:browser' --",
    "customization": "node tooling/customization/verify.mjs",
    "check:customization": "node tooling/customization/verify.mjs --check",
    "test:sheet": "node tooling/testing/invoke.mjs public --view='root#test:sheet' --",
    "test:minify": "node tooling/testing/invoke.mjs public --view='root#test:minify' --",
    "metadata": "npm run metadata:lazy && node tooling/metadata/generate-elements.ts && npm run metadata:types && npm run metadata:api && npm run customization",
    "metadata:types": "node tooling/metadata/prepared-types.ts",
    "check:types": "node tooling/metadata/prepared-types.ts --check",
    "test:tooling": "node tooling/testing/invoke.mjs public --view='root#test:tooling' --",
    "test:theme": "node tooling/testing/invoke.mjs public --view='root#test:theme' --",
    "metadata:api": "node tooling/metadata/public-graph.ts",
    "check:api": "node tooling/metadata/public-graph.ts --check",
    "test:api": "node tooling/testing/invoke.mjs public --view='root#test:api' --",
    "test:release": "node tooling/testing/invoke.mjs public --view='root#test:release' --",
    "test:scoped-registries": "node tooling/testing/invoke.mjs public --view='root#test:scoped-registries' --",
    "metadata:lazy": "node tooling/metadata/lazy-manifest.ts",
    "check:lazy": "node tooling/metadata/lazy-manifest.ts --check",
    "check:delivery": "node tooling/metadata/verify-delivery-inventory.ts",
    "check:delivery:final": "node tooling/metadata/verify-delivery-inventory.ts --require-final",
    "test:lazy-registries": "node tooling/testing/invoke.mjs public --view='root#test:lazy-registries' --",
    "test:extended:node": "node tooling/testing/invoke.mjs public --view='root#test:extended:node' --",
    "test:extended:button": "node tooling/testing/invoke.mjs public --view='root#test:extended:button' --",
    "test:extended:portability": "node tooling/testing/invoke.mjs public --view='root#test:extended:portability' --",
    "test:extended:types": "node tooling/testing/invoke.mjs public --view='root#test:extended:types' --",
    "test:union": "node tooling/testing/invoke.mjs comprehensive",
    "test:plan": "node tooling/testing/invoke.mjs comprehensive --plan",
    "test:inventory": "node tooling/testing/execution-manifest.mjs",
    "check:smoke": "node tooling/integration-gates/run.mjs --mode smoke",
    "check:integration": "node tooling/integration-gates/run.mjs --mode integration",
    "test:integration-gates": "node --test tooling/integration-gates/runner.test.mjs"
  },
  "dependencies": {
    "lit": "3.3.3",
    "signal-polyfill": "0.2.2",
    "signal-utils": "0.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "html-minifier-next": "8.6.0",
    "lightningcss": "1.33.0",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "postcss": "8.5.28",
    "@typescript/typescript6": "6.0.2",
    "@wc-toolkit/cem-generator": "file:tooling/metadata/vendor/cem-generator/cem-generator-0.1.10-en-cem.14.tgz",
    "@wc-toolkit/cem-generator-lit": "file:tooling/metadata/vendor/cem-generator-lit/cem-generator-lit-0.1.11-en-cem.5.tgz",
    "@wc-toolkit/cem-generator-utils": "file:tooling/metadata/vendor/cem-generator-utils/cem-generator-utils-0.1.3-en-cem.6.tgz",
    "magic-string": "1.4.2"
  },
  "engines": {
    "node": "^24.21.0 || >=26.10.0 <27",
    "npm": ">=12.1.0 <13"
  },
  "packageManager": "npm@12.1.0",
  "overrides": {
    "@lit-labs/ssr@4.1.0": {
      "parse5": "8.0.1",
      "@parse5/tools": "0.7.0"
    },
    "@wc-toolkit/cem-generator": "$@wc-toolkit/cem-generator",
    "@wc-toolkit/cem-generator-utils": "$@wc-toolkit/cem-generator-utils"
  }
}
