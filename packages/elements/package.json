{
  "name": "@en-reve/elements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "custom-elements.json",
    "public-types.json",
    "public-api.json"
  ],
  "sideEffects": [
    "./dist/define/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./public-types.json": "./public-types.json",
    "./public-api.json": "./public-api.json"
  },
  "dependencies": {
    "@en-reve/primitives": "0.1.0",
    "@en-reve/styles": "0.1.0",
    "@lit/context": "1.1.6",
    "lit": "3.3.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "prosemirror-view": "^1.42.3"
  },
  "scripts": {
    "build": "node ../../tooling/metadata/lazy-manifest.ts && node ../../node_modules/typescript/bin/tsc -b",
    "clean": "node ../../node_modules/typescript/bin/tsc -b --clean"
  }
}
